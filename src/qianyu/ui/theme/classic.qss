/* QianYu classic theme (warm metal / tabletop receiver) */
/* 浅语影音 0.9 — dark theme */
QMainWindow, QWidget {
    background: #2a241d;
    color: #eadcc0;
    font-size: 13px;
}
QLabel#nowTitle {
    font-size: 20px;
    font-weight: 600;
    color: #fff2d2;
    padding-top: 4px;
}
QLabel#cover {
    background: #3d3125;
    border: 1px solid #5f4832;
    border-radius: 8px;
    color: #d7a24b;
    font-size: 54px;
}
QLabel#nowMeta {
    color: #bda987;
    padding-bottom: 6px;
}
QMenuBar {
    background: #2a241d;
    color: #eadcc0;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #4c3a27;
}
QMenu {
    background: #342b21;
    color: #eadcc0;
    border: 1px solid #5f4832;
}
QLineEdit {
    background: #342b21;
    border: 1px solid #5f4832;
    border-radius: 5px;
    padding: 6px 10px;
    selection-background-color: #d7a24b;
}
QLineEdit:focus {
    border-color: #d7a24b;
}
QPushButton {
    background: #232a3d;
    border: 1px solid #5f4832;
    border-radius: 5px;
    padding: 5px 12px;
}
QPushButton:hover {
    background: #2d3550;
}
QPushButton:pressed {
    background: #1b2132;
}
QTableWidget, QListWidget {
    background: #1b1f2d;
    alternate-background-color: #342b21;
    border: 1px solid #262d42;
    border-radius: 5px;
    selection-background-color: #2f4a9e;
    outline: 0;
}
QTableWidget::item, QListWidget::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background: #3d3125;
    color: #9aa3bd;
    border: 0;
    border-bottom: 1px solid #5f4832;
    padding: 6px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #5f4832;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #d7a24b;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
    background: #eadcc0;
}
QSlider::handle:horizontal:hover {
    background: #ffffff;
}
QSplitter::handle {
    background: #262d42;
    width: 3px;
}
QStatusBar {
    background: #141722;
    color: #bda987;
}
QScrollBar:vertical {
    background: #1b1f2d;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #363f5c;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QMessageBox, QDialog {
    background: #1b1f2d;
}
QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #fff2d2;
    padding: 2px;
}
QLabel#stats {
    color: #bda987;
    font-size: 12px;
}
QLabel#emptyHint {
    color: #bda987;
    font-size: 15px;
    background: #1b1f2d;
    border: 1px dashed #5f4832;
    border-radius: 10px;
    padding: 30px;
}
QPushButton#primaryButton {
    background: #d7a24b;
    border-color: #d7a24b;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryButton:hover {
    background: #4c7dff;
}
QHeaderView {
    background: #3d3125;
}
QHeaderView::section {
    background-color: #3d3125;
    color: #9aa3bd;
    border: 0;
    border-bottom: 1px solid #5f4832;
    padding: 8px 8px;
}
QTableView {
    background: #1b1f2d;
    alternate-background-color: #342b21;
    selection-background-color: #2f4a9e;
    selection-color: #ffffff;
    gridline-color: transparent;
}
QTableView QScrollBar:vertical {
    background: #1b1f2d;
    width: 10px;
    margin: 0;
}
QTableView QScrollBar::handle:vertical {
    background: #3a435e;
    border-radius: 5px;
    min-height: 24px;
}
QTableView QScrollBar::add-line:vertical, QTableView QScrollBar::sub-line:vertical {
    height: 0;
}
QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #22283a;
}
QTableView::item:hover {
    background: #232a3d;
}
QTableView::item:selected {
    background: #2f4a9e;
    color: #ffffff;
}
QListWidget::item {
    padding: 7px 8px;
    border-radius: 4px;
    margin: 1px 2px;
}
QListWidget::item:hover:!selected {
    background: #232a3d;
}
QListWidget::item:selected {
    background: #2f4a9e;
    color: #ffffff;
}
QHeaderView::section {
    padding: 8px 8px;
}
QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}
QLabel#cover {
    border-radius: 12px;
}
QLabel#nowPageTitle {
    font-size: 38px;
    font-weight: 700;
    color: #ffffff;
    background: transparent;
}
QLabel#nowPageMeta {
    font-size: 16px;
    color: #b8c2db;
    padding-bottom: 12px;
    background: transparent;
}
QLabel#nowPageCover {
    background: rgba(20, 24, 36, 180);
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 16px;
    color: #ffffff;
    font-size: 72px;
}
QListWidget#nowPageLyrics {
    background: transparent;
    border: 0;
    color: #dbe3f7;
    font-size: 21px;
}
QListWidget#nowPageLyrics::item {
    padding: 9px 6px;
}
QListWidget#nowPageLyrics::item:selected {
    background: rgba(59, 110, 245, 150);
    color: #ffffff;
}

/* Classic remote-control style for the video transport bar */
#videoControls {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3b2f23, stop:1 #211a13);
    border-top: 1px solid #6e5235;
}
#videoControls QLabel {
    color: #eadcc0;
    font-family: "Consolas", monospace;
}
#videoControls QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5a432d, stop:1 #3a2b1e);
    border: 1px solid #85633f;
    border-radius: 10px;
    color: #f4dfb8;
    padding: 5px 11px;
    min-height: 22px;
}
#videoControls QPushButton:hover {
    background: #6d5135;
    border-color: #c59a63;
}
#videoControls QPushButton:pressed {
    background: #2a1f15;
}
#videoControls QPushButton:checked {
    background: #8a6334;
    color: #fff2d2;
}
#videoControls QComboBox {
    background: #2c2218;
    border: 1px solid #6e5235;
    border-radius: 8px;
    color: #eadcc0;
    padding: 4px 8px;
}
#videoControls QSlider::groove:horizontal {
    height: 5px;
    background: #1b1510;
    border-radius: 2px;
}
#videoControls QSlider::handle:horizontal {
    background: #d7a24b;
    border: 1px solid #f0cc87;
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
